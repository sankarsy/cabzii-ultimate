# Copy to .env.local — use ONE backend block only (do not duplicate keys).

# Live API Windows host (api.cabzii.in): set this so next dev/build cannot SSG-storm port 8000.
# Leave unset on Vercel and on dedicated frontend/CI machines.
# CABZII_PROTECT_LIVE_API=1

# Local frontend machine talking to a non-production / staging API:
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Production frontend builds (Vercel / CI only — never the live API Windows PC):
# BACKEND_URL=https://api.cabzii.in
# NEXT_PUBLIC_BACKEND_URL=https://api.cabzii.in

GOOGLE_SITE_VERIFICATION=

# Social profiles (must include https:// — bare "cabzii.in" breaks Facebook links)
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cabzii.in/
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/cabzii.in

GOOGLE_MAPS_API_KEY=

# Optional map tiles for live tracking (defaults to OpenStreetMap; do not put secret keys in NEXT_PUBLIC_*)
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap

# OpenStreetMap address search (Nominatim) — free, used by default
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CabziiCabBooking/1.0 (contact@cabzii.in)

# OpenRouteService — driving distance & route (optional; falls back to estimate)
OPENROUTESERVICE_API_KEY=

# OpenAI — Enterprise AI SEO (admin generate buttons)
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: on-demand SEO ISR. Server-only — never NEXT_PUBLIC_.
# POST /api/admin/revalidate with header x-revalidation-secret, or a super_admin Bearer token.
# REVALIDATION_SECRET=
